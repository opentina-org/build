Register a Radxa Cubie A7A device under sunxi/cortexa53.

A733 (A55+A76, ARMv8.2-A) is binary-compatible with cortexa53 userspace.
build/build.sh consumes the generic rootfs.tar.gz only; kernel 6.12 has no
sun60i-a733 dts, so the shared Device/sun60i-a733 template ships a plain
gzip'd Image (no FIT/dtb) and skips per-device images. The real kernel/dtb
come from build/sources/linux.
---
 target/linux/sunxi/image/cortexa53.mk | 18 ++++++++++++++++++
 1 file changed, 18 insertions(+)

diff --git a/target/linux/sunxi/image/cortexa53.mk b/target/linux/sunxi/image/cortexa53.mk
index 50b286a..fb3e74d 100644
--- a/target/linux/sunxi/image/cortexa53.mk
+++ b/target/linux/sunxi/image/cortexa53.mk
@@ -146,3 +146,21 @@ define Device/xunlong_orangepi-zero-plus
   $(Device/sun50i-h5)
 endef
 TARGET_DEVICES += xunlong_orangepi-zero-plus
+
+define Device/sun60i-a733
+  SOC := sun60i-a733
+  KERNEL_NAME := Image
+  # Kernel 6.12 has no sun60i-a733 dts; these boards boot with the kernel
+  # and dtb from build/sources, so ship a plain gzip'd Image (no FIT/dtb)
+  # and skip per-device images. Only the generic rootfs.tar.gz is consumed.
+  KERNEL := kernel-bin | gzip
+  IMAGES :=
+endef
+
+define Device/radxa_cubie-a7a
+  DEVICE_VENDOR := Radxa
+  DEVICE_MODEL := Cubie A7A (rootfs-only; kernel/dtb from build/sources)
+  SUPPORTED_DEVICES += radxa-cubie-a7a sun60i-a733-radxa-a7a
+  $(Device/sun60i-a733)
+endef
+TARGET_DEVICES += radxa_cubie-a7a
