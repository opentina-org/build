# Draft sunxi/cortexa53 OpenWrt config for the DEMO AIOT A733 board. Not
# validated against hardware. recipes.sh::build_openwrt repacks the rootfs
# into the partition size set by OPENWRT_ROOTFS_MB, so PARTSIZE here is
# intermediate-only.

CONFIG_TARGET_sunxi=y
CONFIG_TARGET_sunxi_cortexa53=y
# MULTI_PROFILE is required for CONFIG_TARGET_DEVICE_* symbols to exist;
# the 'Default' profile drops the device line and builds every sdcard image.
CONFIG_TARGET_MULTI_PROFILE=y
CONFIG_TARGET_BOARD="sunxi"
CONFIG_TARGET_SUBTARGET="cortexa53"
CONFIG_TARGET_DEVICE_sunxi_cortexa53_DEVICE_demo_aiot_a733=y

CONFIG_TARGET_ROOTFS_EXT4FS=y
CONFIG_TARGET_ROOTFS_TARGZ=y
CONFIG_TARGET_ROOTFS_PARTSIZE=256
# CONFIG_TARGET_ROOTFS_SQUASHFS is not set
# CONFIG_TARGET_ROOTFS_INITRAMFS is not set
# CONFIG_TARGET_IMAGES_GZIP is not set

# BUILDBOT pins reproducible defaults but pulls in IB/SDK/toolchain tarballs
# and re-enables every device profile; opt back out of those.
CONFIG_BUILDBOT=y
# CONFIG_TARGET_ALL_PROFILES is not set
# CONFIG_IB is not set
# CONFIG_SDK is not set
# CONFIG_MAKE_TOOLCHAIN is not set

CONFIG_DEVEL=y
