 target/linux/sunxi/armv8/config-6.12  | 138 ++++++++++++++++++++++++++
 target/linux/sunxi/armv8/target.mk    |  15 +++
 target/linux/sunxi/image/armv8.mk     |  25 +++++
 4 files changed, 180 insertions(+), 1 deletion(-)

